<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws the whole UI, so this theme only needs to give the window a
      dark, chrome-free surface. NoActionBar avoids a title bar flashing on a TV.
    -->
    <style name="Theme.Kino" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
